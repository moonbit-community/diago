import {
  "Milky2018/diago",
  "Milky2018/diago/diagram",
  "Milky2018/diago/engine_api",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

import {
  "moonbitlang/core/debug",
} for "wbtest"

supported_targets = "wasm"

options(
  link: {
    "wasm": {
      "exports": [
        "abi_version:abi_version",
        "transfer_ptr:transfer_ptr",
        "transfer_capacity:transfer_capacity",
        "render:render",
        "highlight:highlight",
        "result_len:result_len",
        "result_error_kind:result_error_kind",
        "result_required_len:result_required_len",
      ],
      "export-memory-name": "memory",
      "heap-start-address": 16777216,
    },
  },
)
