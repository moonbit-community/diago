import {
  "Milky2018/diago",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/debug",
} for "wbtest"

supported_targets = "wasm"

options(
  link: {
    "wasm": {
      "exports": [
        "set_input:set_input",
        "write_input_byte:write_input_byte",
        "get_output_len:get_output_len",
        "read_output_byte:read_output_byte",
        "render_svg:render_svg",
        "render_svg_with_engine:render_svg_with_engine",
        "render_ascii:render_ascii",
        "render_ascii_with_engine:render_ascii_with_engine",
        "render_unicode:render_unicode",
        "render_unicode_with_engine:render_unicode_with_engine",
      ],
    },
  },
)
